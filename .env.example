# Optional server defaults for local or personal development.
# These keys are ignored unless SKETCHCAST_ALLOW_SERVER_KEYS=true.
SKETCHCAST_ALLOW_SERVER_KEYS=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
SKETCHCAST_MODEL=claude-opus-4-8
DEEPGRAM_API_KEY=

# Optional hosted Creator Cloud. Leave every value blank for the safe,
# fully functional Community/BYOK edition.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_ANNUAL=
STRIPE_PRICE_FOUNDING_ANNUAL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Some Vercel Marketplace plans expose these equivalent names instead:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hosted production should set this true only after Clerk, Stripe, and Upstash
# are all configured. Community self-hosts can leave sync unmetered or off.
SKETCHCAST_REQUIRE_SYNC_SUBSCRIPTION=false

# Cloud sync is off by default. Enable it only after adding durable
# platform rate limits and a private Blob store.
SKETCHCAST_ENABLE_CLOUD_SYNC=false

# Required only when encrypted project sync is enabled.
# Provision with a private Vercel Blob store and pull with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
